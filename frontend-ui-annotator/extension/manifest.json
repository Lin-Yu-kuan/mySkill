{
  "manifest_version": 3,
  "name": "Frontend UI Annotator 便條紙",
  "version": "3.2.0",
  "description": "在目前分頁啟動便條紙、保存草稿並匯出 UI 回饋。",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" } }
  },
  "action": {
    "default_title": "在此分頁啟動便條紙"
  }
}
